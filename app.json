{
  "expo": {
    "name": "Self Aura",
    "slug": "self-aura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo2.png",
    "scheme": "selfaura",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfaura.management",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.selfaura.management",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo2.png",
        "backgroundImage": "./assets/logo2.png",
        "monochromeImage": "./assets/logo2.png"
      }
    },
    "web": {
      "favicon": "./assets/logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Self Aura to access your photos.",
          "savePhotosPermission": "Allow Self Aura to save photos and videos to your library.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo2.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28c1f053-a12f-4f68-b02a-34124c7692bf"
      }
    }
  }
}