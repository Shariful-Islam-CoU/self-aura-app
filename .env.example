# Base URL of the existing self_aura_backend API. Must include the /api prefix.
#
# Expo inlines every EXPO_PUBLIC_* variable into the public JS bundle - these
# values are NOT secrets and must never hold credentials, JWT secrets,
# Cloudinary API secrets, database strings, or payment keys. Those belong
# exclusively to self_aura_backend.
#
# Development: localhost is fine here. The app automatically replaces it with
# the machine running `npx expo start` (the Metro host), which is also where
# the backend runs, so a phone/emulator reaches it without editing this value.
# A non-localhost value (a remote or staging server) is always used as-is.
# Override only when the backend is NOT on the Metro host, for example:
#   Android emulator, no LAN:  http://10.0.2.2:5000/api
#   Physical device over USB:  run `adb reverse tcp:5000 tcp:5000`, keep localhost
#   Remote server:             https://your-backend.example.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Base URL of the web storefront (used for deep links, sharing, etc.).
# Must include the protocol (http:// or https://) and NO trailing slash.
# Android emulator: use http://10.0.2.2:3000
# iOS simulator:    use http://localhost:3000
# Physical device:  use your machine's LAN IP, e.g. http://192.168.1.20:3000
# Production:       https://self-aura.onrender.com
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
EXPO_PUBLIC_WEB_BASE_URL=https://self-aura.shop

# Optional display name shown in the app.
EXPO_PUBLIC_APP_NAME=Self Aura

# Keep React Native's built-in fetch as the global instead of Expo SDK 57's
# WinterCG `expo/fetch`. The app's media uploads send local files as the
# React-Native-proprietary FormData part `{ uri, name, type }`, which
# `expo/fetch` does not support (it throws "Unsupported FormDataPart
# implementation", surfaced in the UI as "Network request failed").
# RN's fetch supports that part and streams the file from disk.
EXPO_PUBLIC_USE_RN_FETCH=1
